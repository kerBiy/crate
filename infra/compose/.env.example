# Copy to infra/compose/.env (git-ignored) and set real values.
# No quotes around values: the services load this file as .properties (local profile).
# Postgres superuser (only used by the init script and for admin work)
POSTGRES_PASSWORD=change-me

# One owner role per service database
USERS_DB_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
REVIEWS_DB_PASSWORD=change-me

# user-service: invite codes accepted at registration (comma-separated)
INVITE_CODES=change-me
